<%- include('partials/header') %>
    <section class="page-hero about-hero" aria-labelledby="about-page-heading">
      <div class="wrap about-hero-layout">
        <div class="about-hero-copy">
          <p class="section-label"><%= about.title %></p>
          <h1 class="page-title about-title" id="about-page-heading"><%= about.heading.lead %> <em><%= about.heading.accent %></em></h1>
          <p class="page-lede"><%= about.intro %></p>
          <ul class="profile-links" role="list" aria-label="Professional profiles">
            <% profileLinks.forEach((link) => { %>
            <li><a class="button-text" href="<%= link.href %>"><%= link.label %> <span aria-hidden="true">↗</span></a></li>
            <% }) %>
          </ul>
        </div>
        <div class="about-portrait">
          <picture>
            <source type="image/webp" srcset="<%= portrait.webp.map((s) => `${s.src} ${s.width}w`).join(', ') %>" sizes="<%= portrait.sizes %>">
            <img src="<%= portrait.fallback %>" alt="<%= portrait.alt %>" width="<%= portrait.width %>" height="<%= portrait.height %>" decoding="async">
          </picture>
        </div>
      </div>
    </section>

    <section class="section about-story" aria-label="Background">
      <div class="wrap">
        <div class="about-story-copy">
          <% about.background.forEach((paragraph) => { %>
          <p><%= paragraph %></p>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="section section--cream about-approach" aria-labelledby="how-i-work-heading">
      <div class="wrap about-approach-layout">
        <h2 id="how-i-work-heading"><%= about.howIWork.heading %></h2>
        <div class="about-approach-copy">
          <% about.howIWork.paragraphs.forEach((paragraph) => { %>
          <p><%= paragraph %></p>
          <% }) %>
        </div>
      </div>
    </section>

    <section class="section contact" aria-labelledby="about-contact-heading">
      <div class="wrap">
        <p class="section-label"><span>Next /</span> Have something in mind?</p>
        <h2 class="contact-title" id="about-contact-heading">Let’s make it <em>happen.</em></h2>
        <div class="contact-row">
          <p>Tell me about the problem you’re trying to solve, the workflow you want to simplify, or the idea you want to build.</p>
          <a class="contact-cta" href="/contact">Send a message <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
<%- include('partials/footer') %>
