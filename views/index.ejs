<%- include('partials/header') %>
    <section class="hero" aria-labelledby="hero-heading">
      <div class="hero-grid" aria-hidden="true"></div>
      <div class="wrap hero-inner">
        <p class="hero-kicker"><span class="hero-kicker-dot" aria-hidden="true"></span>Human insight. Technical possibility.</p>
        <div class="hero-layout">
          <div class="hero-copy">
            <p class="hero-eyebrow"><%= site.name %> / <%= site.role %></p>
            <h1 class="hero-title" id="hero-heading">
              <span class="hero-line">Make</span>
              <span class="hero-line hero-outline">complex</span>
              <em class="hero-line hero-accent">feel simple.</em>
            </h1>
            <p class="hero-intro">Useful applications. Thoughtful AI. Connected workflows. Built around people.</p>
            <div class="hero-actions">
              <a class="button button-primary" href="#work">Explore my work <span aria-hidden="true">↓</span></a>
              <a class="button-text" href="/contact">Start a conversation <span aria-hidden="true">→</span></a>
            </div>
          </div>
          <div class="hero-art" aria-hidden="true">
            <div class="art-glow"></div>
            <div class="art-shadow"></div>
            <div class="sculpture">
              <div class="ribbon ribbon-back"></div>
              <div class="ribbon ribbon-front"></div>
              <div class="ribbon ribbon-edge"></div>
              <img class="sculpture-mark" src="/brand/ag-monogram-reversed.svg" alt="" width="330" height="200">
            </div>
            <span class="art-label art-label-top">Idea <span>↘</span></span>
            <span class="art-label art-label-bottom"><span>↗</span> Reality</span>
            <span class="art-caption"><span>+</span> The space between idea &amp; execution</span>
          </div>
        </div>
        <div class="hero-footer">
          <p>Designed with intention. Built to be used.</p>
          <a class="hero-scroll" href="#work">Scroll to explore <span aria-hidden="true">↓</span></a>
        </div>
      </div>
    </section>

    <p class="service-band">
      <span>Applications</span><b aria-hidden="true">✳</b><span>AI integration</span><b aria-hidden="true">✳</b><span>Automation</span>
    </p>

    <section class="section work" id="work" aria-labelledby="work-heading">
      <div class="wrap">
        <div class="section-top">
          <p class="section-label"><span>01 /</span> Selected work</p>
          <p class="status-note">Project previews in development</p>
        </div>
        <div class="split-heading">
          <h2 id="work-heading">Less friction. <em>More possibility.</em></h2>
          <p>Practical ideas, brought to life. Real projects, their problems, process, and results, will appear here.</p>
        </div>
        <ol class="project-list" role="list">
          <% projectPlaceholders.forEach((project, index) => { const n = String(index + 1).padStart(2, '0'); %>
          <li class="project project--<%= project.variant %>">
            <article class="project-card" aria-labelledby="project-<%= n %>-title">
              <div class="project-preview" aria-hidden="true">
                <span class="preview-label"><%= project.category %></span>
                <% if (project.variant === 'composition') { %>
                <div class="preview-composition">
                  <span class="preview-small">From the first idea</span>
                  <strong>What if<br>it just<br><em>worked?</em></strong>
                  <img class="preview-stamp" src="/brand/ag-monogram-reversed.svg" alt="" width="330" height="200">
                </div>
                <% } else if (project.variant === 'workflow') { %>
                <div class="preview-workflow">
                  <span>Input</span><i></i><span class="preview-core"><img src="/brand/ag-monogram-reversed.svg" alt="" width="50" height="30"></span><i></i><span>Outcome</span>
                </div>
                <strong class="preview-headline">Make room<br>for <em>better work.</em></strong>
                <% } else if (project.variant === 'signal') { %>
                <div class="preview-signal"><i></i><i></i><i></i><i></i><i></i><i></i><i></i></div>
                <strong class="preview-headline">Signal,<br><em>not noise.</em></strong>
                <% } else { %>
                <div class="preview-layers"><i></i><i></i><i></i></div>
                <strong class="preview-headline">Layer by<br><em>layer.</em></strong>
                <% } %>
                <span class="preview-foot">Concept art · not an application screenshot</span>
              </div>
              <div class="project-meta">
                <p class="project-kicker"><%= n %> / <%= project.category %></p>
                <h3 id="project-<%= n %>-title"><%= project.heading %></h3>
                <p class="placeholder-badge">Development placeholder. Real project coming.</p>
              </div>
            </article>
          </li>
          <% }) %>
        </ol>
      </div>
    </section>

    <section class="section services" id="services" aria-labelledby="services-heading">
      <div class="wrap">
        <div class="section-top">
          <p class="section-label"><span>02 /</span> What I build</p>
        </div>
        <div class="services-layout">
          <div class="services-intro">
            <h2 id="services-heading">Practical tools for <em>real work.</em></h2>
            <a class="button-text" href="/services">Explore services in detail <span aria-hidden="true">→</span></a>
          </div>
          <ol class="service-list" role="list">
            <% services.forEach((service, index) => { %>
            <li class="service">
              <span class="service-number" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
              <h3><%= service.title %></h3>
              <p><%= service.summary %></p>
            </li>
            <% }) %>
          </ol>
        </div>
      </div>
    </section>

    <section class="section about" id="about" aria-labelledby="about-heading">
      <div class="wrap about-layout">
        <p class="section-label"><span>03 /</span> The person behind the build</p>
        <h2 id="about-heading">Curiosity meets <em>follow-through.</em></h2>
        <div class="about-copy">
          <p class="about-lead">I’m Amber, a practical application and automation builder.</p>
          <p>I turn real-world problems into useful tools, explain my decisions clearly, and use AI thoughtfully.</p>
        </div>
        <ol class="principles" role="list">
          <% principles.forEach((principle, index) => { %>
          <li>
            <span class="principle-number" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
            <h3><%= principle.title %></h3>
            <p><%= principle.text %></p>
          </li>
          <% }) %>
        </ol>
      </div>
    </section>

    <section class="section contact" id="contact" aria-labelledby="contact-heading">
      <div class="wrap">
        <p class="section-label"><span>04 /</span> Have something in mind?</p>
        <h2 class="contact-title" id="contact-heading">Let’s make it <em>happen.</em></h2>
        <div class="contact-row">
          <p>Tell me about the problem you’re trying to solve, the workflow you want to simplify, or the idea you want to build.</p>
          <a class="contact-cta" href="/contact">Send a message <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
<%- include('partials/footer') %>
