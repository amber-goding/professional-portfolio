<%- include('partials/header') %>
    <section class="hero" aria-labelledby="hero-heading">
      <div class="wrap">
        <ul class="stickers" role="list" aria-hidden="true">
          <% heroStickers.forEach((sticker, index) => { %><li class="sticker sticker--<%= index + 1 %>"><%= sticker %></li><% }) %>
        </ul>
        <h1 class="hero-title" id="hero-heading">Make complex<br> <em>feel simple.</em></h1>
        <div class="hero-row">
          <div class="hero-intro">
            <img src="/images/amber-goding-portrait-400.webp" alt="Portrait of Amber Goding" width="400" height="400">
            <p><strong>I’m Amber Goding,</strong> a full-stack developer and AI-augmented builder. I turn real-world problems into useful tools, explain my decisions clearly, and use AI thoughtfully.</p>
          </div>
          <div class="hero-actions">
            <a class="button button-primary" href="#work">See the work <span aria-hidden="true">↘</span></a>
            <a class="button button-outline" href="/contact">Start a conversation</a>
          </div>
        </div>
      </div>
    </section>

    <div class="ticker" data-ticker>
      <div class="ticker-track" aria-hidden="true">
        <% for (let copy = 0; copy < 2; copy++) { %>
        <p class="ticker-move"><% for (let repeat = 0; repeat < 2; repeat++) { services.forEach((service) => { %><span><%= service.title %></span><% }) } %></p>
        <% } %>
      </div>
      <button class="ticker-toggle" type="button" aria-pressed="false" data-ticker-toggle hidden>Pause motion</button>
    </div>

    <section class="section work" id="work" aria-labelledby="work-heading">
      <div class="wrap">
        <p class="kicker" data-reveal>Selected work</p>
        <h2 id="work-heading" data-reveal>Less friction. <em>More possibility.</em></h2>
        <ol class="work-list" role="list">
          <% featuredProjects.forEach((project, index) => { const n = String(index + 1).padStart(2, '0'); const shot = project.card.image; %>
          <li class="project" data-reveal>
            <article class="project-card work-item" aria-labelledby="project-<%= n %>-title">
              <span class="work-num" aria-hidden="true"><%= n %></span>
              <div class="work-copy">
                <p class="chip"><%= project.category %></p>
                <h3 id="project-<%= n %>-title"><a class="project-link" href="/projects/<%= project.slug %>"><%= project.title %></a></h3>
                <p><%= project.card.summary %></p>
                <% if (shot.sample) { %><p class="work-note">Screenshot shows the app’s fictional sample data.</p><% } %>
                <p class="work-cta" aria-hidden="true">Read the case study <span>→</span></p>
              </div>
              <div class="work-shot">
                <%- include('partials/picture', { shot, sizes: '(min-width: 56rem) 45vw, 100vw' }) %>
              </div>
            </article>
          </li>
          <% }) %>
        </ol>
      </div>
    </section>

    <section class="section services" id="services" aria-labelledby="services-heading">
      <div class="wrap">
        <p class="kicker" data-reveal>Services</p>
        <h2 id="services-heading" data-reveal>Practical tools <em>for real work.</em></h2>
        <ol class="svc-grid" role="list">
          <% services.forEach((service, index) => { %>
          <li class="svc" data-reveal>
            <span class="svc-num" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %> /</span>
            <h3><%= service.title %></h3>
            <p><%= service.summary %></p>
          </li>
          <% }) %>
        </ol>
        <a class="button-text" href="/services" data-reveal>Explore services in detail <span aria-hidden="true">→</span></a>
      </div>
    </section>

    <section class="section stack" id="stack" aria-labelledby="stack-heading">
      <div class="wrap">
        <div class="stack-head" data-reveal>
          <div>
            <p class="kicker">Tech stack &amp; tools</p>
            <h2 id="stack-heading"><%= stackIntro.heading.lead %> <em><%= stackIntro.heading.accent %></em></h2>
          </div>
          <p class="stack-lede"><%= stackIntro.lede %></p>
        </div>
        <div class="stack-ui" data-stack data-reveal>
          <div class="stack-tabs" data-stack-tabs hidden>
            <% stackGroups.forEach((group, index) => { %>
            <button class="stack-tab" type="button" id="stack-tab-<%= group.id %>" aria-controls="stack-panel-<%= group.id %>" data-stack-tab>
              <span class="stack-tab-num" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
              <span class="stack-tab-label"><%= group.label %></span>
              <span class="stack-tab-count"><%= group.tools.length %> tools</span>
            </button>
            <% }) %>
          </div>
          <div class="stack-panels">
            <% stackGroups.forEach((group, index) => { %>
            <section class="stack-panel" id="stack-panel-<%= group.id %>" aria-labelledby="stack-panel-<%= group.id %>-heading" data-stack-panel>
              <div class="stack-panel-head">
                <span class="stack-panel-num" aria-hidden="true"><%= String(index + 1).padStart(2, '0') %></span>
                <h3 id="stack-panel-<%= group.id %>-heading"><%= group.label %></h3>
              </div>
              <ul class="stack-tools" role="list">
                <% group.tools.forEach((tool, toolIndex) => { %><li style="--i: <%= toolIndex %>"><%= tool %></li><% }) %>
              </ul>
              <p class="stack-usage"><%= group.usage %></p>
              <p class="stack-projects"><span>See it in:</span>
                <% group.projects.forEach((slug) => { %><a href="/projects/<%= slug %>"><%= projectTitles[slug] %></a><% }) %>
              </p>
            </section>
            <% }) %>
          </div>
        </div>
        <aside class="build-tools" aria-labelledby="build-tools-heading" data-reveal>
          <h3 id="build-tools-heading"><%= buildTools.heading %></h3>
          <ul class="build-tools-list" role="list">
            <% buildTools.tools.forEach((tool) => { %><li><%= tool %></li><% }) %>
          </ul>
          <p><%= buildTools.note %></p>
        </aside>
      </div>
    </section>

    <section class="section about" id="about" aria-labelledby="about-heading">
      <div class="wrap about-layout">
        <div class="about-photo" data-reveal>
          <img src="/images/amber-goding-portrait-800.webp" srcset="/images/amber-goding-portrait-400.webp 400w, /images/amber-goding-portrait-800.webp 800w, /images/amber-goding-portrait-1200.webp 1200w" sizes="(min-width: 56rem) 30rem, 90vw" alt="Portrait of Amber Goding" width="800" height="800" loading="lazy" decoding="async">
          <span class="sticker sticker--1" aria-hidden="true">Hi, I’m Amber</span>
        </div>
        <div class="about-copy" data-reveal>
          <p class="kicker">About</p>
          <h2 id="about-heading">Thoughtful tools start with <em>understanding people.</em></h2>
          <blockquote class="about-quote"><p>“I welcome feedback because a useful application needs to make sense to <span>the people using it.</span>”</p></blockquote>
          <p class="about-body">I start by asking questions and clarifying the problem before suggesting a solution. From there, I break the work into manageable steps, communicate progress, and explain the decisions along the way.</p>
          <a class="button-text" href="/about">More about Amber <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>

    <section class="section contact" id="contact" aria-labelledby="contact-heading">
      <div class="wrap" data-reveal>
        <p class="kicker">Have something in mind?</p>
        <h2 class="contact-title" id="contact-heading">Let’s make it <em>happen.</em></h2>
        <div class="contact-row">
          <p>Tell me about the problem you’re trying to solve, the workflow you want to simplify, or the idea you want to build.</p>
          <a class="contact-cta" href="/contact">Start a conversation <span aria-hidden="true">→</span></a>
        </div>
      </div>
    </section>
<%- include('partials/footer') %>
