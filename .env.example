# Placeholder values only. Never put real credentials or real addresses in this file.
# Copy to .env (ignored by Git) for local use; `npm run dev` loads it automatically.
# On Railway, set these as service variables instead. Railway sets PORT itself.

# Optional locally. Defaults to 3000 when unset.
PORT=3000

# --- Contact form (Resend HTTPS API) ---
# All three are required. If any is missing or invalid, the contact page shows
# an "unavailable" notice and nothing is sent.
RESEND_API_KEY=re_your_resend_api_key
CONTACT_TO_EMAIL=inbox@example.com
CONTACT_FROM_EMAIL="Portfolio Contact <contact@mail.example.com>"

# Recommended: signs form tokens so open forms survive restarts and redeploys.
# At least 32 characters. Generate one with:
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
CONTACT_FORM_SECRET=

# Optional: extra origins allowed to submit the form, comma-separated.
# Only needed if the site is served through a proxy that changes the Host header.
# CONTACT_ALLOWED_ORIGINS=https://example.com,https://www.example.com

# Optional: request header that carries the real client IP for rate limiting.
# Defaults to x-real-ip on Railway (detected via RAILWAY_ENVIRONMENT_ID) and to the
# direct connection address elsewhere. Set to "none" to always use the connection address.
# CLIENT_IP_HEADER=x-real-ip
